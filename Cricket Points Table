interface Team {
    pos: number;
    name: string;
    matches: number;
    won: number;
    lost: number;
    drawn: number;
}

let teams: Team[] = [
    { pos: 1, name: "Australia", matches: 0, won: 0, lost: 0, drawn: 0 },
    { pos: 2, name: "India", matches: 0, won: 0, lost: 0, drawn: 0 },
    { pos: 3, name: "New Zealand", matches: 0, won: 0, lost: 0, drawn: 0 },
    { pos: 4, name: "England", matches: 0, won: 0, lost: 0, drawn: 0 }
];

function updateTeamData(
    teamName: string,
    matches: number,
    won: number,
    lost: number,
    drawn: number
): void {
    const team: Team | undefined = teams.find(
        (t: Team) => t.name === teamName
    );

    if (team) {
        team.matches = matches;
        team.won = won;
        team.lost = lost;
        team.drawn = drawn;
    }
}

function displayTable(): void {
    console.log("\n🏆 ANPS Cricket League 2025\n");

    console.table(
        teams.map(team => ({
            Pos: team.pos,
            Team: team.name,
            Matches: team.matches,
            Won: team.won,
            Lost: team.lost,
            Drawn: team.drawn
        }))
    );
}

function clearTable(): void {
    teams = teams.map(team => ({
        ...team,
        matches: 0,
        won: 0,
        lost: 0,
        drawn: 0
    }));
}

displayTable();

updateTeamData("Australia", 3, 2, 1, 0);
updateTeamData("India", 3, 3, 0, 0);
updateTeamData("New Zealand", 3, 1, 2, 0);
updateTeamData("England", 3, 0, 3, 0);

displayTable();

clearTable();

console.log("\nAfter clearing:");
displayTable();
